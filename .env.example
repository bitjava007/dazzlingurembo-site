# Copier ce fichier en .env.local et le compléter. Ne jamais commiter de vraies valeurs.

# URL publique du site (sans barre finale), utilisée pour le SEO et le sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Coordonnées publiques provisoires (Phase 2-3). À partir de la Phase 4, elles se
# règlent dans l'administration (Paramètres du site). Laisser vide si non fourni :
# l'élément correspondant n'est alors pas affiché.
SITE_WHATSAPP_NUMBER=
SITE_CONTACT_EMAIL=
SITE_PHONE=
SITE_ADDRESS=
SITE_INSTAGRAM_URL=
SITE_FACEBOOK_URL=
SITE_TIKTOK_URL=

# Supabase (Phase 4) — projet dédié au site, distinct de l'ERP.
# Seules l'URL et la clé publique (anon / publishable) sont exposées au navigateur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
